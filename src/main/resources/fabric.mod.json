{
  "schemaVersion": 1,
  "id": "activeragdoll",
  "version": "${version}",
  "name": "Active Ragdoll",
  "description": "Your player becomes a physics-driven active ragdoll with procedural walking and foot placement.",
  "authors": ["Nesonaragirl"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.activeragdoll.ActiveRagdollClient"]
  },
  "mixins": [
    { "config": "activeragdoll.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
